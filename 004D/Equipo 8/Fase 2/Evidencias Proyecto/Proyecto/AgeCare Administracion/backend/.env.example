# Copia este archivo como .env y ajusta los valores
# En Neon/Render también sirve postgresql://... o postgres://... (se convierte al driver psycopg automáticamente)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agecare_admin
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=wellq.co.uk,agecare.cl
# Secreto compartido con la pasarela de pagos para firmar el webhook (HMAC-SHA256)
PASARELA_WEBHOOK_SECRET=secreto-webhook-demo
# Cada cuántos segundos corre el planificador (monitor, publicaciones programadas). 0 = apagado
PLANIFICADOR_INTERVALO_SEG=60
# Zona horaria para fechas de negocio (vigencia de documentos legales, métricas diarias)
ZONA_HORARIA=America/Santiago
